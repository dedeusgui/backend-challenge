    "/wagering/transactions": {
      "post": {
        "operationId": "submitWagerTransaction",
        "summary": "Submete uma operação de apostas",
        "tags": ["wagering"],
        "responses": {
          "201": {
            "description": "Aplicada agora (PROCESSED). `idempotentReplay` = false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "200": {
            "description": "Replay idêntico de uma operação já processada. `balance` é o saldo observado quando ela foi aplicada, não o saldo atual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "202": {
            "description": "Aceita, aguardando a referência (PENDING_REFERENCE). A operação é retida, com retentativas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Rejeitada por regra de negócio (REJECTED), com `failureCode`. Não reenviar sem mudança.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                },
                "example": {
                  "transactionId": "0192f298-345e-7e38-af88-e43f851a819d",
                  "status": "REJECTED",
                  "failureCode": "INSUFFICIENT_BALANCE",
                  "balance": {
                    "amount": "10.00",
                    "currency": "BRL"
                  },
                  "idempotentReplay": false
                }
              }
            }
          },
          "400": {
            "description": "A requisição não passou na validação do contrato.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "IDEMPOTENCY_KEY_REQUIRED",
                    "message": "..."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta a chave, ela é desconhecida ou foi revogada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": ["Bearer"]
                }
              }
            }
          },
          "403": {
            "description": "A chave não pode agir neste recurso: provedor diferente, ou rota só para operador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "..."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Carteira inexistente. Nada é gravado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "WALLET_NOT_FOUND",
                    "message": "..."
                  }
                }
              }
            }
          },
          "409": {
            "description": "A mesma chave com payload diferente. Não é replay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "IDEMPOTENCY_CONFLICT",
                    "message": "..."
                  }
                }
              }
            }
          },
          "413": {
            "description": "O corpo passa de 16 kB. Recusado antes da autenticação e da análise.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "..."
                  }
                }
              }
            }
          },
          "503": {
            "description": "Carteira ocupada numa disputa perdida. Tente de novo após o Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "ConcurrencyConflict",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string",
                  "enum": ["1"]
                }
              }
            }
          }
        },
        "description": "Chave PROVIDER age só pelo próprio `providerId`; chave OPERATOR age por qualquer provedor. `OPENING` é interno e é recusado com 400 INVALID_TRANSACTION.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Obrigatória. Fonte da verdade da idempotência, por provedor. Padrão recomendado: `{providerId}:{externalTransactionId}`.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "example": "provider-a:transaction-123"
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "description": "Até 128 caracteres de `A-Za-z0-9._:-`. Ausente, a API gera um.",
            "schema": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "example": {
                "providerId": "provider-a",
                "externalTransactionId": "transaction-123",
                "playerId": "0192f28f-5dc0-7d58-bdb2-814ad6a0f4a1",
                "walletId": "0192f291-27dd-7d3f-8071-5f8685deef37",
                "roundId": "round-987",
                "gameId": "fortune-chimp",
                "kind": "BET",
                "money": {
                  "amount": "25.00",
                  "currency": "BRL"
                }
              }
            }
          }
        }
      }
    },
