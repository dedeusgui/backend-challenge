                }
              }
            }
          },
          "403": {
            "description": "A chave não pode agir neste recurso: provedor diferente, ou rota só para operador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "..."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Carteira inexistente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "WALLET_NOT_FOUND",
                    "message": "..."
                  }
                }
              }
            }
          }
        },
        "description": "Somente chave OPERATOR.",
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
