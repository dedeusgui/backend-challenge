{
  "openapi": "3.1.0",
  "info": {
    "title": "Distributed Wagering Processor: API HTTP",
    "version": "0.1.0",
    "summary": "Operações de apostas de provedores, saldos de carteira e ledger.",
    "description": "Contrato escrito à mão e verificado contra as rotas e as respostas reais (`test/unit/openapi/route-parity.test.ts` e `test/e2e/openapi-responses.test.ts`). Descrições em português; identificadores e exemplos não são traduzidos.\n\n**Autenticação.** `Authorization: Bearer <chave>`. Chave PROVIDER age pelo próprio `providerId`. Chave OPERATOR abre e lê carteiras, reconcilia, lê métricas e age por qualquer provedor. Health é público. Ver ARCHITECTURE §12 e ADR 0007. Autenticação por chave de API é uma decisão registrada, não um IdP externo.\n\n**Idempotência.** `Idempotency-Key` é obrigatória e é a fonte da verdade, por provedor. Mesma chave e mesmo payload: replay (200). Mesma chave e payload diferente: 409.\n\n**Status de transação.** 201 aplicada; 200 replay; 202 aguardando referência; 422 rejeitada por regra (não reenviar sem mudança); 503 com Retry-After para disputa de carteira, que pode ser reenviada.\n\n**Limites.** Corpo acima de 16 kB: 413. Valores monetários com exatamente duas casas. Esta configuração padrão não limita taxa; o modo protegido, com borda Nginx, limita por endereço (ARCHITECTURE §15).",
    "license": {
      "name": "Uso na avaliação técnica da Jungle Gaming"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Stack local do docker-compose.yml, ou a borda do modo protegido, na mesma porta."
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness e readiness. Públicos."
    },
    {
      "name": "wallets",
      "description": "Carteiras, ledger e reconciliação. Somente OPERATOR."
    },
    {
      "name": "wagering",
      "description": "Operações de apostas e consultas por id."
    },
    {
      "name": "providers",
      "description": "Consultas pelo id do provedor."
    },
    {
      "name": "observability",
      "description": "Métricas do processo. Somente OPERATOR."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getHealthLive",
        "summary": "Processo vivo",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "Processo vivo.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok"]
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "description": "Não toca em dependências e não exige chave.",
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getHealthReady",
        "summary": "PostgreSQL e fila alcançáveis",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "PostgreSQL e SQS responderam.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                },
                "example": {
                  "status": "ok",
                  "checks": {
                    "database": "up",
                    "sqs": "up"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Ao menos uma dependência não respondeu. `checks` diz qual.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                },
                "example": {
                  "status": "unavailable",
                  "checks": {
                    "database": "up",
                    "sqs": "down"
                  }
                }
              }
            }
          }
        },
        "security": [],
        "description": "Verifica a conectividade com PostgreSQL e SQS, usada para readiness do processo."
      }
    },
    "/wallets": {
      "post": {
        "operationId": "openWallet",
        "summary": "Abre uma carteira",
        "tags": ["wallets"],
        "responses": {
          "201": {
            "description": "Carteira criada. Com saldo inicial positivo, a transação interna OPENING e o lançamento CREDIT são gravados na mesma transação SQL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletOpened"
                },
                "example": {
                  "id": "0192f291-27dd-7d3f-8071-5f8685deef37",
                  "playerId": "0192f28f-5dc0-7d58-bdb2-814ad6a0f4a1",
                  "balance": {
                    "amount": "1000.00",
                    "currency": "BRL"
                  },
                  "version": 1
                }
              }
            }
          },
          "400": {
            "description": "A requisição não passou na validação do contrato.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "INVALID_MONEY",
                    "message": "..."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Falta a chave, ela é desconhecida ou foi revogada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": ["Bearer"]
                }
              }
            }
          },
          "403": {
            "description": "A chave não pode agir neste recurso: provedor diferente, ou rota só para operador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "..."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Já existe carteira para este playerId e moeda.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "WALLET_ALREADY_EXISTS",
                    "message": "..."
                  }
                }
              }
            }
          },
          "413": {
            "description": "O corpo passa de 16 kB. Recusado antes da autenticação e da análise.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "PAYLOAD_TOO_LARGE",
                    "message": "..."
                  }
                }
              }
            }
          }
        },
        "description": "Somente chave OPERATOR.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenWalletRequest"
              },
              "example": {
                "playerId": "0192f28f-5dc0-7d58-bdb2-814ad6a0f4a1",
                "initialBalance": {
                  "amount": "1000.00",
                  "currency": "BRL"
                }
              }
            }
          }
        }
      }
    },
