                  }
                }
              }
            }
          }
        },
        "description": "Uma chave PROVIDER que pede transação de outro provedor recebe 404, a mesma resposta de um id inexistente, para que o id não possa ser sondado. Decisão registrada em ARCHITECTURE §12.",
        "parameters": [
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "description": "Identificador interno da transação.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/providers/{providerId}/wagering/transactions/{externalTransactionId}": {
      "get": {
        "operationId": "getProviderWagerTransaction",
        "summary": "Lê uma transação pelo id do provedor",
        "tags": ["providers"],
        "responses": {
          "200": {
            "description": "Snapshot armazenado da transação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionView"
                }
              }
            }
          },
          "401": {
            "description": "Falta a chave, ela é desconhecida ou foi revogada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": ["Bearer"]
                }
              }
            }
          },
          "403": {
            "description": "A chave não pode agir neste recurso: provedor diferente, ou rota só para operador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "..."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Transação inexistente para este provedor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "TRANSACTION_NOT_FOUND",
                    "message": "..."
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Identificador do provedor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "externalTransactionId",
            "in": "path",
            "required": true,
            "description": "Identificador da transação no provedor.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Consulta uma transação pelo identificador externo do provedor autenticado ou autorizado."
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "summary": "Contadores e resumos deste processo",
        "tags": ["observability"],
        "responses": {
          "200": {
            "description": "Contadores e resumos deste processo, desde a sua inicialização. Sem identificadores nos rótulos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsSnapshot"
                }
              }
            }
          },
          "401": {
            "description": "Falta a chave, ela é desconhecida ou foi revogada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHENTICATED",
                    "message": "..."
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "enum": ["Bearer"]
                }
              }
            }
          },
          "403": {
            "description": "A chave não pode agir neste recurso: provedor diferente, ou rota só para operador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "FORBIDDEN",
                    "message": "..."
                  }
                }
              }
            }
          }
        },
        "description": "Somente chave OPERATOR. Cada réplica informa os próprios números; a superfície do worker tem o mesmo formato, em outra porta interna."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Chave de API emitida por `bun run auth:create`. Mostrada uma vez; só o hash é guardado."
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": ["amount", "currency"],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?[0-9]{1,18}\\.[0-9]{2}$",
            "description": "Decimal string com exatamente duas casas. Nunca número."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO-4217 em maiúsculas. O desafio usa BRL."
          }
        },
        "example": {
          "amount": "25.00",
          "currency": "BRL"
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Código estável e legível por máquina."
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": ["status", "checks"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "unavailable"]
          },
          "checks": {
            "type": "object",
            "required": ["database", "sqs"],
            "properties": {
              "database": {
                "type": "string",
                "enum": ["up", "down"]
              },
              "sqs": {
                "type": "string",
                "enum": ["up", "down"]
              }
            }
          }
        }
      },
      "OpenWalletRequest": {
        "type": "object",
        "required": ["playerId", "initialBalance"],
        "additionalProperties": false,
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador do jogador no provedor. Texto, não necessariamente UUID."
          },
          "initialBalance": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "WalletOpened": {
        "type": "object",
        "required": ["id", "playerId", "balance", "version"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": "string"
          },
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "WalletView": {
        "type": "object",
        "required": ["id", "playerId", "currency", "balance", "version", "updatedAt"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "description": "Sobe somente quando o saldo muda."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LedgerEntry": {
        "type": "object",
        "required": [
          "seq",
          "id",
          "transactionId",
          "direction",
          "amount",
          "balanceBefore",
          "balanceAfter",
          "createdAt"
        ],
        "properties": {
          "seq": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Ordem do ledger dentro da carteira, como texto decimal: é um bigint do PostgreSQL, que JSON não representa com segurança como número."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "direction": {
            "type": "string",
            "enum": ["DEBIT", "CREDIT"]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "balanceBefore": {
            "$ref": "#/components/schemas/Money"
          },
          "balanceAfter": {
            "$ref": "#/components/schemas/Money"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LedgerPage": {
        "type": "object",
        "required": ["entries", "nextCursor"],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LedgerEntry"
            }
          },
          "nextCursor": {
            "type": ["string", "null"],
            "description": "Null quando não há mais páginas."
          }
        }
      },
      "ReconciliationReport": {
        "type": "object",
        "required": [
          "walletId",
          "storedBalance",
          "calculatedBalance",
          "difference",
          "consistent",
          "checkedEntries"
        ],
        "properties": {
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "storedBalance": {
            "$ref": "#/components/schemas/Money"
          },
          "calculatedBalance": {
            "$ref": "#/components/schemas/Money"
          },
          "difference": {
            "$ref": "#/components/schemas/Money"
          },
          "consistent": {
            "type": "boolean"
          },
          "checkedEntries": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SubmitRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerId",
          "externalTransactionId",
          "playerId",
          "walletId",
          "roundId",
          "gameId",
          "kind",
          "money"
        ],
        "properties": {
          "providerId": {
            "type": "string",
            "minLength": 1
          },
          "externalTransactionId": {
            "type": "string",
            "minLength": 1
          },
          "playerId": {
            "type": "string",
            "minLength": 1
          },
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "roundId": {
            "type": "string",
            "minLength": 1
          },
          "gameId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["BET", "WIN", "LOSS", "REFUND", "ROLLBACK"],
            "description": "OPENING é interno e não é aceito."
          },
          "money": {
            "$ref": "#/components/schemas/Money"
          },
          "referenceExternalTransactionId": {
            "type": "string",
            "minLength": 1,
            "description": "Obrigatória para REFUND e ROLLBACK. Opcional para WIN e LOSS, que podem nomear a BET que liquidam."
          }
        }
      },
      "SubmitResponse": {
        "type": "object",
        "required": ["transactionId", "status", "balance", "idempotentReplay"],
        "properties": {
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": ["PROCESSED", "PENDING_REFERENCE", "REJECTED"]
          },
          "balance": {
            "$ref": "#/components/schemas/Money"
          },
          "idempotentReplay": {
            "type": "boolean"
          },
          "failureCode": {
            "type": "string",
            "description": "Presente quando REJECTED. Taxonomia em ARCHITECTURE §3."
          }
        }
      },
      "TransactionView": {
        "type": "object",
        "required": [
          "transactionId",
          "providerId",
          "externalTransactionId",
          "walletId",
          "playerId",
          "roundId",
          "gameId",
          "kind",
          "status",
          "money",
          "referenceExternalTransactionId",
          "failureCode",
          "resultingBalance",
          "processedAt",
          "createdAt"
        ],
        "properties": {
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "providerId": {
            "type": "string"
          },
          "externalTransactionId": {
            "type": "string"
          },
          "walletId": {
            "type": "string",
            "format": "uuid"
          },
          "playerId": {
            "type": "string"
          },
          "roundId": {
            "type": "string"
          },
          "gameId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["OPENING", "BET", "WIN", "LOSS", "REFUND", "ROLLBACK"]
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "PENDING_REFERENCE", "PROCESSED", "REJECTED", "FAILED"]
          },
          "money": {
            "$ref": "#/components/schemas/Money"
          },
          "referenceExternalTransactionId": {
            "type": ["string", "null"]
          },
          "failureCode": {
            "type": ["string", "null"]
          },
          "resultingBalance": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Money"
              },
              {
                "type": "null"
              }
            ]
          },
          "processedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MetricsSnapshot": {
        "type": "object",
        "required": ["counters", "summaries"],
        "properties": {
          "counters": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "summaries": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["count", "sum", "max"],
              "properties": {
                "count": {
                  "type": "integer"
                },
                "sum": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
