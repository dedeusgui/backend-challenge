{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/migrate.ts",
    "src/auth.ts",
    "src/worker.ts",
    "scripts/*.ts",
    "test/**/*.test.ts",
    "test/demo/**/*.ts",
    "test/edge/**/*.ts",
    "test/load/**/*.ts",
    "test/perf/**/*.ts",
    "test/features/steps/**/*.ts",
    "src/shared/infrastructure/database/migrations/**/*.ts",
    "test/support/crashing-before-commit-worker.ts",
    "test/support/crashing-worker.ts",
    "test/support/slow-worker.ts"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "bun": true,
  "cucumber": true,
  "ignoreDependencies": ["@mikro-orm/decorators", "@mikro-orm/nestjs"],
  "ignoreIssues": {
    "test/concurrency/support/process-cluster.ts": ["exports"],
    "test/integration/support/test-database.ts": ["exports"],
    "test/support/openapi-document.ts": ["exports", "types"],
    "test/support/sql-state.ts": ["exports"],
    "test/unit/load/run-fixture.ts": ["exports"]
  }
}
