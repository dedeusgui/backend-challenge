{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json src test",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fast": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "test:integration": "bun test test/integration",
    "check:all": "bun run check:fast && bun run test:integration && bun run test:concurrency && bun run test:e2e",
    "test:concurrency": "bun test test/concurrency",
    "test:e2e": "bun test test/e2e"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1125.0",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/decorators": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.2"
  }
}
