{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json src test",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fast": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit && bun run arch:check",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "test:integration": "bun test test/integration",
    "check:all": "bun run check:fast && bun run test:infra && bun run test:integration && bun run test:concurrency && bun run test:e2e && bun run test:features",
    "test:concurrency": "bun test test/concurrency",
    "test:e2e": "bun test test/e2e",
    "db:migrate": "bun run src/migrate.ts",
    "auth:create": "bun run src/auth.ts create",
    "auth:revoke": "bun run src/auth.ts revoke",
    "outbox:requeue": "bun run scripts/outbox-requeue.ts",
    "test:load": "bun run test/load/load-test.ts",
    "load:consolidate": "bun run test/load/consolidate.ts",
    "edge:up": "docker compose -f docker-compose.yml -f docker-compose.protected.yml up --build -d --wait",
    "edge:down": "docker compose -f docker-compose.yml -f docker-compose.protected.yml down",
    "test:edge": "bun test test/edge",
    "bench:edge": "bun run test/edge/overhead.ts",
    "demo:finance": "bun run test/demo/finance.ts",
    "edge:check": "bun run edge:up && bun run test:edge; status=$?; bun run edge:down; exit $status",
    "test:infra": "bun test test/infra",
    "site:build": "bun run scripts/build-site.ts",
    "docs:catalogos": "bun run scripts/build-catalogos.ts",
    "graficos:build": "bun run scripts/build-graficos.ts",
    "gate:registrar": "bun run scripts/record-gate.ts",
    "diagrams:export": "bun run scripts/export-diagrams.ts",
    "test:features": "bun --bun node_modules/.bin/cucumber-js --tags 'not @bloqueado' --require 'test/features/steps/**/*.ts' 'test/features/**/*.feature'",
    "arch:check": "depcruise --config .dependency-cruiser.cjs src",
    "deadcode:check": "knip"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1125.0",
    "@mikro-orm/core": "^7.2.0",
    "@mikro-orm/migrations": "^7.2.0",
    "@mikro-orm/postgresql": "^7.2.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.2"
  }
}
